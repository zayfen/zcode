ack moves down)\n    const m4a = makeMove(s3, { from: { row: 3, col: 8 }, to: { row: 5, col: 8 } });\n    expect(m4a.valid).toBe(true);\n    const s4a = m4a.newState!;\n\n    // Step 5: Red chariot (8,0) → (4,0)\n    const m5 = makeMove(s4a, { from: { row: 8, col: 0 }, to: { row: 4, col: 0 } });\n    expect(m5.valid).toBe(true);\n    const s5 = m5.newState!;\n\n    // Step 6: Black chariot (1,8) → (4,8)\n    const legal6 = getLegalMoves(s5.board, { row: 1, col: 8 });\n    console.log('Legal moves for black chariot at (1,8) in s5:', legal6.map(p => `${p.row},${p.col}`));\n    \n    const m6 = makeMove(s5, { from: { row: 1, col: 8 }, to: { row: 4, col: 8 } });\n    expect(m6.valid).toBe(true);\n    const s6 = m6.newState!;\n\n    // Verify both chariots are on row 4\n    expect(s6.board[4]![8]!.type).toBe('chariot');\n    expect(s6.board[4]![8]!.player).toBe('black');\n    expect(s6.board[4]![0]!.type).toBe('chariot');\n    expect(s6.board[4]![0]!.player).toBe('red');\n\n    // Step 7: Black chariot (4,8) → (4,0) — capture!\n    const legal7 = getLegalMoves(s6.board, { row: 4, col: 8 });\n    console.log('Legal moves for black chariot at (4,8) in s6:', legal7.map(p => `${p.row},${p.col}`));\n    \n    const hasCapture = legal7.some(p => p.row === 4 && p.col === 0);\n    console.log('Can capture at (4,0)?', hasCapture);\n    \n    const m7 = makeMove(s6, { from: { row: 4, col: 8 }, to: { row: 4, col: 0 } });\n    console.log('Move 7 result: valid =', m7.valid, ', captured =', JSON.stringify(m7.captured));\n    \n    expect(m7.valid).toBe(true);\n    expect(m7.captured).toBeDefined();\n    expect(m7.captured!.type).toBe('chariot');\n    expect(m7.captured!.player).toBe('red');\n  });\n});\n","path":"src/engine/__tests__/debug-capture-sequence.test.ts"}

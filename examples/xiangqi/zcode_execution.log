    console.log('Legal moves for red chariot at (8,0) in s4:', legal5.map(p => `${p.row},${p.col}`));\n    \n    const m5 = makeMove(s4, { from: { row: 8, col: 0 }, to: { row: 4, col: 0 } });\n    console.log('Move 5 valid:', m5.valid);\n    expect(m5.valid).toBe(true);\n    const s5 = m5.newState!;\n\n    // Now verify: black chariot at (4,8), red chariot at (4,0)\n    console.log('Board[4][8]:', JSON.stringify(s5.board[4]![8]));\n    console.log('Board[4][0]:', JSON.stringify(s5.board[4]![0]));\n    expect(s5.board[4]![8]!.type).toBe('chariot');\n    expect(s5.board[4]![8]!.player).toBe('black');\n    expect(s5.board[4]![0]!.type).toBe('chariot');\n    expect(s5.board[4]![0]!.player).toBe('red');\n\n    // Step 6: Black chariot (4,8) → (4,0) — capture\n    const legal6 = getLegalMoves(s5.board, { row: 4, col: 8 });\n    console.log('Legal moves for black chariot at (4,8) in s5:', legal6.map(p => `${p.row},${p.col}`));\n    \n    const hasCapture = legal6.some(p => p.row === 4 && p.col === 0);\n    console.log('Can capture at (4,0)?', hasCapture);\n    \n    const m6 = makeMove(s5, { from: { row: 4, col: 8 }, to: { row: 4, col: 0 } });\n    console.log('Move 6 result: valid =', m6.valid, ', captured =', JSON.stringify(m6.captured));\n    \n    expect(m6.valid).toBe(true);\n    expect(m6.captured).toBeDefined();\n    expect(m6.captured!.type).toBe('chariot');\n    expect(m6.captured!.player).toBe('red');\n  });\n});\n","path":"src/engine/__tests__/debug-capture-sequence.test.ts"}
